# Quantum AI Investment Advisor - Production Environment Template
# -------------------------------------------------------------
# Copy this file to .env and fill in the actual production secrets.

# Core System
NODE_ENV=production
LOG_LEVEL=INFO
USER_ID=default_prod_user

# Databases
DB_USER=postgres
DB_PASS=REPLACE_WITH_SECURE_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=investment_advisor

# AI Providers (API Keys)
OPENAI_API_KEY=sk-xxxx
GOOGLE_API_KEY=AIxxxx
OPENROUTER_API_KEY=sk-or-xxxx

# Market Services
FINNHUB_API_KEY=xxxx
FRED_API_KEY=xxxx

# Notifications
NOTIFY_SERVICE_URL=http://notification:8001/api/v1/notify
TELEGRAM_TOKEN=xxxx
TELEGRAM_CHAT_ID=xxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxx
LINE_USER_ID=xxxx

# Infrastructure
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Monitoring (Signoz/OTEL)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# External Access
NGROK_AUTHTOKEN=xxxx
BACKEND_URL=http://mcp_server:8000
NEXT_PUBLIC_API_URL=https://your-public-domain.com
