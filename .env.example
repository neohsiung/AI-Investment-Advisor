# ── AI Investment Advisor — Environment Configuration ────────────────
# Copy this file to .env and fill in the values.
#
# NOTE: LLM Provider API keys (OpenAI, Google, OpenRouter, etc.),
#       notification tokens (Telegram, LINE), and market data API keys
#       are managed in the **User Settings Database** via the
#       Next.js Dashboard → Settings page. Do NOT add them here.

# ── Core ─────────────────────────────────────────────────────────────
# Fernet key encrypting sensitive rows in the `settings` table (ENC: prefix)
# — including the eToro credential pair.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ROTATING THIS IS A TWO-STEP OPERATION. Changing the value here does not
# re-encrypt anything; it orphans every ciphertext in the database, and the
# failure is silent — _decrypt logs and returns the raw ciphertext, so
# credentials come back looking like values. Run
# scripts/rotate_encryption_keys.py with both the old and new key set first.
# 輪換此金鑰必須先跑 scripts/rotate_encryption_keys.py 重新加密資料庫，
# 只改這裡會讓既有密文變成孤兒，且失敗是靜默的。
APP_SECRET_KEY=REPLACE_WITH_FERNET_KEY
COMPOSE_PROJECT_NAME=investment_advisor

# ── Trading Safety ───────────────────────────────────────────────────
# ⚠️  paper is NOT a usable mode in this project. The eToro token has no demo
#     permission (a deliberate decision — there is no demo path here), so
#     TRADING_MODE=paper makes every broker call return InsufficientPermissions.
#     It is a full stop, not a degraded mode. See AGENTS.md (2026-08-23).
#
#     The real brake for a fresh single-box install is the DB setting
#     `ai_trading_enabled=false`, which `./start.sh selfhost` sets for you.
#     Keep TRADING_MODE unset unless you specifically want the global override.
#
# paper: force every broker into demo mode. Breaks all broker calls here.
# live:  explicit opt-in to real trading (still respects the owner's own
#        broker credentials and etoro_mode setting).
# Unset (default): no global override; the ai_trading_enabled setting decides.
#
# ⚠️ 本專案 token 無 demo 權限，paper 會讓所有 broker 呼叫失敗，
#    安全預設請用 DB 設定 ai_trading_enabled=false，此處保持不設定。
# TRADING_MODE=

# ── Configuration precedence (settled 2026-08-23) ────────────────────
# The PostgreSQL `settings` table is the highest authority for business
# settings (broker credentials, risk parameters, model choice, channels).
# This file is the INFRASTRUCTURE layer only: connection strings, keys,
# NGROK_DOMAIN, and global brakes. Read order inside SettingsService is
#   settings table > .env > litellm-config.yaml / llm_tier_bindings > code
# Do NOT add per-user business settings here expecting them to win.
#
# TRADING_MODE above is the one deliberate inversion: it lives here and
# overrides the settings table on purpose, so a global trading brake
# cannot be defeated from the per-user UI.
#
# 設定優先序：settings 表 > .env > litellm-config.yaml > 程式預設。
# 本檔僅負責基礎設施層；TRADING_MODE 是刻意的反向例外（全域煞車）。

# ── n8n Workflow Automation ──────────────────────────────────────────
# start.sh re-imports n8n_workflow_template.json on every COLD dev/prod
# start. The template carries a top-level "id": "1", so the import is an
# UPSERT onto workflow 1 — anything you edited in the n8n UI is overwritten.
# On n8n 2.x the imported workflow is also left DEACTIVATED unless the
# import passes --activeState=fromJson (start.sh does).
# Set this to 1 to skip the import entirely and keep whatever n8n has.
# Treated as "off": empty, 0, false, no, off.
# Every import exports the current workflow to backups/ first.
# SKIP_N8N_IMPORT=1

# ── Database ─────────────────────────────────────────────────────────
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=investment_advisor

# ── Encryption ───────────────────────────────────────────────────────
# Fernet key for encrypting Provider API keys at rest in the database
# (`llm_providers.encrypted_api_key`, FERN: prefix).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Same rotation caveat as APP_SECRET_KEY above — re-encrypt with
# scripts/rotate_encryption_keys.py before swapping the value here.
# 輪換方式同上，換值前先跑 scripts/rotate_encryption_keys.py。
LLM_CREDENTIAL_KEY=<replace-with-fernet-key>

# ── Google OAuth (Optional) ──────────────────────────────────────────
# GOOGLE_CLIENT_SECRET_PATH=client_secret.json
# REDIRECT_URI=http://localhost:8501

# ── ngrok Tunnel (Optional, for external webhook access) ─────────────
# Reserve a static domain at https://dashboard.ngrok.com/domains
NGROK_AUTHTOKEN=<replace-with-your-ngrok-authtoken>
NGROK_DOMAIN=<replace-with-your-static-domain>.ngrok-free.dev

# ── Database (required by docker-compose.prod.yml) ───────────────────
# docker-compose.prod.yml interpolates all four. DB_PASS is declared with
# `${DB_PASS:?}`, i.e. compose HARD-FAILS if it is empty. `./start.sh selfhost`
# generates DB_PASS and pins DB_USER/DB_NAME; set them by hand for a manual
# `docker compose up`.
# docker-compose.prod.yml 需要這四個；DB_PASS 未設會直接讓 compose 失敗。
DB_USER=postgres
DB_NAME=advisor_prod
DB_PASS=
# DB_HOST / DB_PORT default to the compose service (postgres:5432).

# ── Redis (required by docker-compose.prod.yml) ──────────────────────
REDIS_PASSWORD=

# ── Local single-operator access ─────────────────────────────────────
# There is no login. The bind address is the security boundary: compose
# publishes the gateway on 127.0.0.1 only.
#
#   AUTH_MODE=none   (default) no authentication at all — loopback only.
#   AUTH_MODE=token            every request needs ADMIN_TOKEN, via
#                              `Authorization: Bearer <token>` or X-Admin-Token.
#
# The API refuses to start if it is bound to a non-loopback interface while
# AUTH_MODE=none (override with ALLOW_INSECURE_BIND=1 only if something else
# authenticates in front of it).
# 單機單人模式預設免登入，僅綁 loopback；對外暴露請設 AUTH_MODE=token。
AUTH_MODE=none
ADMIN_TOKEN=

# OWNER_ID pins the single owner's UUID. Left empty, the app adopts the oldest
# existing `users` row, or creates one on first boot and you can paste it here
# afterwards to make it explicit.
# 留空時自動採用最早的 users 列，或首次啟動時建立。
OWNER_ID=
OWNER_EMAIL=

# ── Cost controls ────────────────────────────────────────────────────
# The sentinel tick is the biggest driver of the LLM bill: each tick can fan out
# into a multi-agent council debate. Default */15 (96/day) instead of the old
# every-minute (1440/day). Set to "*" to restore the old behaviour.
# sentinel tick 是 LLM 帳單主因，預設每 15 分鐘。
SENTINEL_TICK_CRON_MINUTE=*/15
BROKER_SYNC_CRON_MINUTE=*/15

# ── Observability (opt-in) ───────────────────────────────────────────
# SigNoz (ClickHouse + ZooKeeper + collector + 2 migrators) is ~5 containers and
# 4-6GB RAM. It is a compose profile now, off by default; the app falls back to
# structured logs because tracing self-disables when the endpoint is unset.
#   OBSERVABILITY=1 ./start.sh prod
# SigNoz 改為選配 profile，預設關閉以省下 4-6GB RAM。
OTEL_EXPORTER_OTLP_ENDPOINT=
