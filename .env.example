# SMTP Configuration (Required for Email Reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_RECIPIENT=recipient@example.com

# Database Configuration (Optional, defaults to SQLite)



# Database Configuration (Optional, defaults to SQLite)
# DB_TYPE=sqlite
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=portfolio

# AI Configuration
# AI_PROVIDER=Google Gemini
# AI_MODEL=gemini-1.5-pro # (Legacy/Default)
# AI_MODEL_SMART=gemini-1.5-pro
# AI_MODEL_FAST=gemini-1.5-f# AI Models (Unified)
# Note: These values serve as BOOTSTRAP defaults.
# Runtime settings are managed via the Web UI (05_Settings) and stored in DB.
# API_KEY=your_gemini_key
# LLM_API_KEY=your_llm_key (Optional)


# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_SMART=google/gemini-2.0-flash-exp

# External Data APIs
POLYGON_API_KEY=your_polygon_api_key
FMP_API_KEY=your_fmp_api_key
FRED_API_KEY=your_fred_api_key_here

# Google OAuth (Optional, for Web App)
# GOOGLE_CLIENT_SECRET_PATH=client_secret.json
# COOKIE_KEY=your_secret_cookie_key
# REDIRECT_URI=http://localhost:8501


# Docker Configuration
COMPOSE_PROJECT_NAME=investment_advisor
