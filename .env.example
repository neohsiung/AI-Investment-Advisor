# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI Models — 4-Tier Architecture
# System 0 (Reflex)   → Classification, Routing
# System 1 (Fast)     → Summarization, Extraction
# System 2 (Smart)    → Analysis, Conversation
# System 2+ (Advanced)→ CIO Decisions, Strategy
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# AI_PROVIDER=Google Gemini
# AI_MODEL_NANO=openai/gpt-4.1-nano          # $0.10/$0.40 per M tokens
# AI_MODEL_FAST=google/gemini-1.5-flash      # $0.30/$2.50 per M tokens
# AI_MODEL_SMART=google/gemini-1.5-pro       # $1.25/$10.00 per M tokens
# AI_MODEL_ADVANCED=anthropic/claude-sonnet  # $3.00/$15.00 per M tokens
# API_KEY=your_gemini_key
# BASE_URL=https://openrouter.ai/api/v1 (Optional)

# External Data APIs
POLYGON_API_KEY=your_polygon_api_key
FMP_API_KEY=your_fmp_api_key
FRED_API_KEY=your_fred_api_key_here
TAVILY_API_KEY=your_tavily_api_key

# Google OAuth (Optional, for Web App)
# GOLOG_LEVEL=INFO
APP_SECRET_KEY=REPLACE_WITH_FERNET_KEY_FROM_FERNET_GENERATE_KEY
GOOGLE_CLIENT_SECRET_PATH=client_secret.json
# COOKIE_KEY=your_secret_cookie_key
# REDIRECT_URI=http://localhost:8501

# Docker Configuration
COMPOSE_PROJECT_NAME=investment_advisor
