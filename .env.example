# SMTP Configuration (Required for Email Reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_RECIPIENT=recipient@example.com

# Database Configuration (Optional, defaults to SQLite)
# DB_TYPE=sqlite
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=portfolio


# Google OAuth (Optional, for Web App)
# GOLOG_LEVEL=INFO
APP_SECRET_KEY=REPLACE_WITH_FERNET_KEY_FROM_FERNET_GENERATE_KEY
GOOGLE_CLIENT_SECRET_PATH=client_secret.json
# COOKIE_KEY=your_secret_cookie_key
# REDIRECT_URI=http://localhost:8501

# Docker Configuration
COMPOSE_PROJECT_NAME=investment_advisor
