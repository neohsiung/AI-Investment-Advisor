{
  "name": "Investment Advisor - RSS Alert Bridge (v4 - Skill Learning)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://mcp_server:8000/webhook/rss-sources",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 InvestmentAdvisor/1.0"
            },
            {
              "name": "X-API-Key",
              "value": "your_api_key_here"
            }
          ]
        },
        "options": {
          "splitIntoItems": true
        }
      },
      "name": "Fetch RSS Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        20,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
            }
          ]
        },
        "options": {},
        "responseFormat": "string"
      },
      "name": "Fetch Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        240,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const rawXml = $json.data;\nif (typeof rawXml !== 'string') return $json;\nconst sanitized = rawXml\n  .replace(/&/g, '&amp;')\n  .replace(/&amp;(amp|lt|gt|quot|apos|#[0-9]+|#x[0-9a-f]+);/gi, '&$1;');\nreturn { data: sanitized };"
      },
      "name": "Sanitize XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Parse XML",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const xml = $json;\nconst ensureArray = (val) => (!val ? [] : Array.isArray(val) ? val : [val]);\nconst normalize = (item) => {\n  const res = { ...item };\n  const flatten = (val) => {\n    if (Array.isArray(val)) val = val[0];\n    if (val && typeof val === 'object') {\n      if (val['$'] && val['$'].href) return val['$'].href;\n      if (val['_']) return val['_'];\n    }\n    return val;\n  };\n  res.title = flatten(item.title) || 'No Title';\n  res.link = flatten(item.link) || '';\n  res.pubDate = flatten(item.pubDate || item.published) || new Date().toISOString();\n  return { json: res };\n};\nif (xml.rss && xml.rss.channel) {\n  const ch = ensureArray(xml.rss.channel)[0];\n  if (ch && ch.item) return ensureArray(ch.item).map(normalize);\n}\nif (xml.feed && xml.feed.entry) return ensureArray(xml.feed.entry).map(normalize);\nreturn [];"
      },
      "name": "Iterate Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mcp_server:8000/webhook/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "your_api_key_here"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "event_type",
              "value": "NEWS_ALERT"
            },
            {
              "name": "ticker",
              "value": "GLOBAL"
            },
            {
              "name": "message",
              "value": "={{ $json.title }}"
            },
            {
              "name": "link",
              "value": "={{ $json.link }}"
            },
            {
              "name": "source_name",
              "value": "={{ $node[\"Fetch RSS Sources\"].json.name }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Send to Advisor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1150,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -200,
        550
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://otel-collector:4318/v1/logs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"resourceLogs\": [{\n    \"resource\": { \"attributes\": [\n      { \"key\": \"service.name\", \"value\": { \"stringValue\": \"n8n-rss-bridge\" } },\n      { \"key\": \"deployment.environment\", \"value\": { \"stringValue\": \"production\" } }\n    ]},\n    \"scopeLogs\": [{ \"logRecords\": [{\n      \"severityText\": \"ERROR\",\n      \"body\": { \"stringValue\": {{ JSON.stringify($json.execution.error.message) }} },\n      \"attributes\": [\n        { \"key\": \"error.node\", \"value\": { \"stringValue\": {{ JSON.stringify($json.execution.error.nodeName) }} } },\n        { \"key\": \"execution.id\", \"value\": { \"stringValue\": {{ JSON.stringify($json.execution.id) }} } },\n        { \"key\": \"workflow.name\", \"value\": { \"stringValue\": {{ JSON.stringify($workflow.name) }} } }\n      ]\n    }]}]\n  }]\n}",
        "options": {}
      },
      "name": "Report Error to OTel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        50,
        550
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "name": "Daily Skill Learning Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -200,
        800
      ],
      "notes": "每日 07:00 觸發 Readwise 技能學習"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mcp_server:8000/webhook/skill-learning",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "your_api_key_here"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"event_type\": \"DAILY_SKILL_LEARNING\",\n  \"source_type\": \"highlight\"\n}",
        "options": {}
      },
      "name": "Trigger Skill Learning",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        50,
        800
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */4 * * *"
            }
          ]
        }
      },
      "name": "Podcast RSS Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -200,
        1100
      ],
      "notes": "每 4 小時檢查 Podcast RSS"
    },
    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════\n// 📻 Podcast RSS Feed Configuration\n// 在此處取消註解或新增 Podcast RSS feeds\n// ═══════════════════════════════════════════════\nconst PODCAST_FEEDS = [\n  { name: 'All-In Podcast',        url: 'https://allinchamathjason.libsyn.com/rss' },\n  // { name: 'Invest Like the Best',  url: 'https://feeds.simplecast.com/JGE3yC0V' },\n  // { name: 'Odd Lots (Bloomberg)',   url: 'https://feeds.bloomberg.com/podcasts/etf_odd_lots.xml' },\n  // { name: 'Masters in Business',    url: 'https://feeds.bloomberg.com/podcasts/masters_in_business.xml' },\n  // { name: 'The Prof G Pod',         url: 'https://feeds.megaphone.fm/WWO3519750118' },\n];\nif (PODCAST_FEEDS.length === 0) return [];\nreturn PODCAST_FEEDS.map(f => ({ json: f }));"
      },
      "name": "Podcast Feed List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        1100
      ],
      "notes": "✏️ 取消註解或新增 Podcast RSS URL"
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 InvestmentAdvisor/1.0"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        },
        "responseFormat": "string"
      },
      "name": "Fetch Podcast Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        240,
        1100
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Extract latest episode with audio URL from podcast RSS\nconst rawXml = $json.data;\nif (!rawXml || typeof rawXml !== 'string') return [];\nconst sanitized = rawXml.replace(/&/g, '&amp;').replace(/&amp;(amp|lt|gt|quot|apos|#[0-9]+|#x[0-9a-f]+);/gi, '&$1;');\nconst items = [];\nconst itemRegex = /<item>(.*?)<\\/item>/gs;\nlet match;\nwhile ((match = itemRegex.exec(sanitized)) !== null && items.length < 1) {\n  const xml = match[1];\n  const tag = (t) => { const m = xml.match(new RegExp(`<${t}[^>]*><!\\\\[CDATA\\\\[(.+?)\\\\]\\\\]><\\\\/${t}>|<${t}[^>]*>([^<]*)<\\\\/${t}>`, 's')); return m ? (m[1]||m[2]||'').trim() : ''; };\n  const enc = xml.match(/<enclosure[^>]+url=[\"']([^\"']+)[\"']/i);\n  const audioUrl = enc ? enc[1].replace(/&amp;/g, '&') : '';\n  if (!audioUrl) continue;\n  items.push({ json: { title: tag('title'), link: tag('link'), description: tag('description') || tag('itunes:summary'), audioUrl, podcastName: $('Podcast Feed List').item.json.name || 'Podcast' } });\n}\nreturn items;"
      },
      "name": "Extract Latest Episode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        1100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mcp_server:8000/webhook/podcast-extract",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "your_api_key_here"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"audioUrl\": \"{{ $json.audioUrl }}\",\n  \"podcastName\": \"{{ $json.podcastName }}\"\n}",
        "options": {}
      },
      "name": "Extract Podcast via Advisor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        700,
        1100
      ],
      "onError": "continueErrorOutput",
      "notes": "Handles transcription and skill learning internally (with chunking support)."
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Report Error to OTel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch RSS Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch RSS Sources": {
      "main": [
        [
          {
            "node": "Fetch Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Feed": {
