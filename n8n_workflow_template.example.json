            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse XML": {
      "main": [
        [
          {
            "node": "Iterate Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Iterate Items": {
      "main": [
        [
          {
            "node": "Send to Advisor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily Skill Learning Trigger": {
      "main": [
        [
          {
            "node": "Trigger Skill Learning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Podcast RSS Trigger": {
      "main": [
        [
          {
            "node": "Podcast Feed List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Podcast Feed List": {
      "main": [
        [
          {
            "node": "Fetch Podcast Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Podcast Feed": {
      "main": [
        [
          {
            "node": "Extract Latest Episode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Latest Episode": {
      "main": [
        [
          {
            "node": "Extract Podcast via Advisor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
