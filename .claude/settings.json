{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/green_gate.py\"",
            "timeout": 960
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "mcp__claude_ai_Github__merge_pull_request",
      "mcp__31afe94d-f68a-4e22-ae08-835cede897e3__merge_pull_request"
    ]
  }
}
