{
  "name": "position_sizing",
  "version": "1.0.0",
  "description": "計算適當的交易數量，考慮實際持倉、現金比例與風險閾值。Calculates appropriate trade quantity considering actual holdings, cash ratio and risk thresholds.",
  "category": "portfolio",
  "tier": "fast",
  "input_schema": {
    "type": "object",
    "properties": {
      "ticker": { "type": "string", "description": "股票代號 (e.g. TSLA, NVDA)" },
      "action": { "type": "string", "enum": ["BUY", "SELL"], "description": "交易方向" },
      "desired_quantity": { "type": "number", "description": "期望交易量（0 = 由系統決定）" },
      "intent": { "type": "string", "enum": ["full_close", "partial_reduce", "auto"], "description": "SELL 語意：full_close=清倉, partial_reduce=減碼, auto=系統判斷" }
    },
    "required": ["ticker", "action"]
  },
  "output_schema": {
    "type": "object",
    "description": "{ recommended_quantity, actual_holding, cash_ratio_before, cash_ratio_after_estimate, reason }"
  },
  "platform": ["linux", "darwin"],
  "tags": ["portfolio", "risk", "sizing", "trading"]
}
